%%
%% Manifest-tree branching factor
%%

{mapping, "stream_s3.rebalance_threshold", "rabbitmq_stream_s3.rebalance_threshold", [
    {datatype, integer}, {validators, ["non_zero_positive_integer"]}
]}.

{translation, "rabbitmq_stream_s3.rebalance_threshold",
fun(Conf) ->
    case cuttlefish:conf_get("stream_s3.rebalance_threshold", Conf, undefined) of
