%%
%% Stream membership reconciliation
%%

{mapping, "stream_s3.continuous_membership_reconciliation.enabled", "rabbitmq_stream_s3.membership_reconciliation_enabled", [
    {datatype, {enum, [true, false]}}]}.

{mapping, "stream_s3.continuous_membership_reconciliation.auto_remove", "rabbitmq_stream_s3.membership_reconciliation_auto_remove", [
    {datatype, {enum, [true, false]}}]}.

{mapping, "stream_s3.continuous_membership_reconciliation.interval", "rabbitmq_stream_s3.membership_reconciliation_interval", [
    {datatype, integer}, {validators, ["non_negative_integer"]}
]}.

{mapping, "stream_s3.continuous_membership_reconciliation.trigger_interval", "rabbitmq_stream_s3.membership_reconciliation_trigger_interval", [
    {datatype, integer}, {validators, ["non_negative_integer"]}
]}.

{mapping, "stream_s3.continuous_membership_reconciliation.target_group_size", "rabbitmq_stream_s3.membership_reconciliation_target_group_size", [
    {datatype, integer}, {validators, ["non_negative_integer"]}
]}.

%% Verbose logging — when enabled, log messages that normally truncate
%% large terms (such as S3 error responses) will print them in full.

{mapping, "stream_s3.verbose_logging", "rabbitmq_stream_s3.verbose_logging", [
    {datatype, {enum, [true, false]}}
]}.

{translation, "rabbitmq_stream_s3.verbose_logging",
fun(Conf) ->
    case cuttlefish:conf_get("stream_s3.verbose_logging", Conf, false) of
        false -> cuttlefish:unset();
        Value -> Value
    end
end}.

