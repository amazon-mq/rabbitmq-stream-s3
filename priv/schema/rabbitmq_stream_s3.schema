%% -*- mode: erlang; -*-

{mapping, "stream_s3.region", "rabbitmq_stream_s3.aws_region", [
    {datatype, binary}
]}.

{translation, "rabbitmq_stream_s3.aws_region",
fun(Conf) ->
    case cuttlefish:conf_get("stream_s3.region", Conf, undefined) of
        undefined -> cuttlefish:unset();
        Value     -> Value
    end
end}.

%% A mapping between region name and top-level domain names.
{mapping, "stream_s3.region_endpoints.$region", "rabbitmq_stream_s3.aws_region_endpoints", [
    {datatype, [binary]}
]}.

{translation, "rabbitmq_stream_s3.aws_region_endpoints",
fun(Conf) ->
    case cuttlefish_variable:filter_by_prefix("stream_s3.region_endpoints", Conf) of
        [] ->
            cuttlefish:unset();
        Settings ->
            lists:foldl(
              fun ({["stream_s3", "region_endpoints", Region0], TLD}, Acc) ->
                      Acc#{list_to_binary(Region0) => TLD};
                  (Other, _Acc) ->
                      cuttlefish:invalid(
                        lists:flatten(io_lib:format("~p is invalid", [Other])))
              end, #{}, Settings)
    end
end}.

