        Value     -> Value
    end
end}.

{mapping, "stream_s3.persist_interval_ms", "rabbitmq_stream_s3.persist_interval_ms", [
    {datatype, integer}, {validators, ["non_negative_integer"]}
]}.

{translation, "rabbitmq_stream_s3.persist_interval_ms",
fun(Conf) ->
    case cuttlefish:conf_get("stream_s3.persist_interval_ms", Conf, undefined) of
