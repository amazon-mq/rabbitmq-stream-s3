%% S3 tiered storage for Osiris.

%%
%% Fragment target size
%%

{mapping, "stream_s3.fragment_target_size", "rabbitmq_stream_s3.fragment_target_size", [
    {datatype, bytesize}
]}.

{translation, "rabbitmq_stream_s3.fragment_target_size",
fun(Conf) ->
    case cuttlefish:conf_get("stream_s3.fragment_target_size", Conf, undefined) of
        undefined -> cuttlefish:unset();
        Value     -> Value
    end
end}.

%%
%% Manifest persist debouncing
%%

{mapping, "stream_s3.persist_threshold", "rabbitmq_stream_s3.persist_threshold", [
    {datatype, integer}, {validators, ["non_negative_integer"]}
]}.

{translation, "rabbitmq_stream_s3.persist_threshold",
fun(Conf) ->
    case cuttlefish:conf_get("stream_s3.persist_threshold", Conf, undefined) of
