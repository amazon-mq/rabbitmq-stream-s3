% vim:ft=erlang:
%

[{stream_s3_region,
  "stream_s3.region = us-west-2",
  [{rabbitmq_stream_s3, [{aws_region, <<"us-west-2">>}]}],
  []},
 {stream_s3_region_endpoints,
  "stream_s3.region_endpoints.us-west-2 = amazonaws.com",
  [{rabbitmq_stream_s3, [{aws_region_endpoints, #{<<"us-west-2">> => <<"amazonaws.com">>}}]}],
  []},
 {stream_s3_access_key_id,
  "stream_s3.access_key_id = AKIAIOSFODNN7EXAMPLE",
  [{rabbitmq_stream_s3, [{aws_access_key, <<"AKIAIOSFODNN7EXAMPLE">>}]}],
  []},
 {stream_s3_secret_key,
  "stream_s3.secret_key = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY",
  [{rabbitmq_stream_s3, [{aws_secret_key, <<"wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY">>}]}],
  []},
 {stream_s3_allow_static_credentials,
  "stream_s3.allow_static_credentials = true",
  [{rabbitmq_stream_s3, [{allow_static_credentials, true}]}],
  []},
 {stream_s3_bucket,
  "stream_s3.bucket = my-tiered-storage-bucket",
  [{rabbitmq_stream_s3, [{bucket, <<"my-tiered-storage-bucket">>}]}],
  []},
 {stream_s3_account_id,
  "stream_s3.account_id = 123456789012",
  [{rabbitmq_stream_s3, [{account_id, <<"123456789012">>}]}],
  []},
 {stream_s3_fragment_target_size,
  "stream_s3.fragment_target_size = 128MB",
  [{rabbitmq_stream_s3, [{fragment_target_size, 134217728}]}],
  []},
 {stream_s3_persist_threshold,
  "stream_s3.persist_threshold = 5",
  [{rabbitmq_stream_s3, [{persist_threshold, 5}]}],
  []},
 {stream_s3_persist_interval_ms,
  "stream_s3.persist_interval_ms = 2000",
  [{rabbitmq_stream_s3, [{persist_interval_ms, 2000}]}],
  []},
 {stream_s3_rebalance_threshold,
  "stream_s3.rebalance_threshold = 1024",
  [{rabbitmq_stream_s3, [{rebalance_threshold, 1024}]}],
  []},
 {stream_s3_membership_reconciliation_enabled,
  "stream_s3.continuous_membership_reconciliation.enabled = true",
  [{rabbitmq_stream_s3, [{membership_reconciliation_enabled, true}]}],
  []},
 {stream_s3_membership_reconciliation_auto_remove,
  "stream_s3.continuous_membership_reconciliation.auto_remove = true",
  [{rabbitmq_stream_s3, [{membership_reconciliation_auto_remove, true}]}],
  []},
 {stream_s3_membership_reconciliation_interval,
  "stream_s3.continuous_membership_reconciliation.interval = 60",
  [{rabbitmq_stream_s3, [{membership_reconciliation_interval, 60}]}],
  []},
 {stream_s3_membership_reconciliation_trigger_interval,
  "stream_s3.continuous_membership_reconciliation.trigger_interval = 10",
  [{rabbitmq_stream_s3, [{membership_reconciliation_trigger_interval, 10}]}],
  []},
 {stream_s3_membership_reconciliation_target_group_size,
  "stream_s3.continuous_membership_reconciliation.target_group_size = 3",
  [{rabbitmq_stream_s3, [{membership_reconciliation_target_group_size, 3}]}],
  []},
 {stream_s3_verbose_logging,
  "stream_s3.verbose_logging = true",
  [{rabbitmq_stream_s3, [{verbose_logging, true}]}],
  []},
 {stream_s3_max_transfer_bytes_per_sec_unlimited,
  "stream_s3.max_transfer_bytes_per_sec = unlimited",
  [{rabbitmq_stream_s3, [{max_transfer_bytes_per_sec, unlimited}]}],
  []},
 {stream_s3_max_transfer_bytes_per_sec_value,
  "stream_s3.max_transfer_bytes_per_sec = 500MB",
  [{rabbitmq_stream_s3, [{max_transfer_bytes_per_sec, 524288000}]}],
  []},
 {stream_s3_max_transfer_burst_bytes,
  "stream_s3.max_transfer_burst_bytes = 1GB\nstream_s3.max_transfer_bytes_per_sec = 500MB",
  [{rabbitmq_stream_s3, [{max_transfer_burst_bytes, 1073741824},
                         {max_transfer_bytes_per_sec, 524288000}]}],
  []},
 {stream_s3_verify_crc_on_read,
  "stream_s3.verify_crc_on_read = true",
  [{rabbitmq_stream_s3, [{verify_crc_on_read, true}]}],
  []},
 {stream_s3_kms_key_id,
  "stream_s3.kms_key_id = arn:aws:kms:us-east-1:123456789012:key/example-key-id",
  [{rabbitmq_stream_s3, [{kms_key_id, <<"arn:aws:kms:us-east-1:123456789012:key/example-key-id">>}]}],
  []},
 {stream_s3_kms_encryption_context,
  "stream_s3.kms_encryption_context.cluster = eu-prod-1\nstream_s3.kms_encryption_context.department = payments",
  [{rabbitmq_stream_s3, [{kms_encryption_context, #{<<"cluster">> => <<"eu-prod-1">>,
                                                    <<"department">> => <<"payments">>}}]}],
  []},
 {stream_s3_kms_encryption_context_escaped_dots,
  "stream_s3.kms_encryption_context.com\\.example\\.tenant = acme",
  [{rabbitmq_stream_s3, [{kms_encryption_context, #{<<"com.example.tenant">> => <<"acme">>}}]}],
  []},
 {stream_s3_gc_enabled,
  "stream_s3.gc.enabled = true",
  [{rabbitmq_stream_s3, [{gc_enabled, true}]}],
  []},
 {stream_s3_gc_interval,
  "stream_s3.gc.interval = 86400000",
  [{rabbitmq_stream_s3, [{gc_interval, 86400000}]}],
  []},
 {stream_s3_gc_mode_dry_run,
  "stream_s3.gc.mode = dry_run",
  [{rabbitmq_stream_s3, [{gc_mode, dry_run}]}],
  []},
 {stream_s3_gc_mode_delete,
  "stream_s3.gc.mode = delete",
  [{rabbitmq_stream_s3, [{gc_mode, delete}]}],
  []}].
